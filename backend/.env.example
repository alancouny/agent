PORT=3001
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-api-key
STABILITY_API_KEY=your-stability-api-key

# Optional: set to enable Bearer token authentication on all /api/* routes
# When set, the frontend must include an API key in Settings → API Key
AGENT_API_KEY=

# Optional: CORS origins (comma-separated). Default allows all local origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: embedding model provider (openai | ollama | none)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
